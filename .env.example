# DealProof environment variables.
# Copy to `.env` at the repo root for local dev (`.env` is git-ignored; never commit it).
# Deployed services read the same names from GCP Secret Manager.

# --- Crustdata: companies, people, funding, headcount, jobs, live web search/fetch
CRUSTDATA_API_KEY=

# --- Anthropic Messages API (direct, official SDK)
ANTHROPIC_API_KEY=
# Model id used for every LLM call (extraction and drafting).
ANTHROPIC_MODEL=claude-haiku-5-5
# Max output tokens per LLM call.
ANTHROPIC_MAX_TOKENS=4096

# --- Email (Resend) for the approved seller request
RESEND_API_KEY=
# Verified sender address, e.g. "DealProof <requests@yourdomain.com>".
EMAIL_FROM=
# false = test mode: sends are recorded as "suppressed (test mode)" and nothing leaves.
EMAIL_SEND_ENABLED=false

# --- Storage
# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require).
DATABASE_URL=
# Private GCS bucket for uploaded case documents.
GCS_BUCKET=
# Uploaded documents are deleted after this many days.
UPLOAD_RETENTION_DAYS=30

# --- Cost control
# Max Crustdata credits a single case may spend; further checks become "Not checked (budget reached)".
CASE_CREDIT_BUDGET=150

# --- Web / CORS
# Origin(s) of the web app allowed to call the API (comma-separated).
WEB_ORIGIN=http://localhost:3000
# Base URL of the API as seen by the browser (inlined into the web build).
NEXT_PUBLIC_API_URL=http://localhost:8000
