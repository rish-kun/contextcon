# DealProof environment variables.
# Copy to `.env` at the repo root for local dev (`.env` is git-ignored; never commit it).
# Deployed services read the same names from GCP Secret Manager.

# --- Crustdata: companies, people, funding, headcount, jobs, live web search/fetch
CRUSTDATA_API_KEY=
# REST base URL and the required x-api-version header value.
CRUSTDATA_BASE_URL=https://api.crustdata.com
CRUSTDATA_API_VERSION=2025-11-01
# Per-request timeout (seconds) and retries on 429 / 5xx / network errors.
CRUSTDATA_TIMEOUT_SECONDS=60
CRUSTDATA_MAX_RETRIES=3

# --- Anthropic Messages API (direct, official SDK)
# Either name works: ANTHROPIC_API_KEY or CLAUDE_API_KEY (ANTHROPIC_API_KEY wins if both are set).
ANTHROPIC_API_KEY=
# Model id used for every LLM call (extraction and drafting).
ANTHROPIC_MODEL=claude-haiku-5-5
# Max output tokens per LLM call.
ANTHROPIC_MAX_TOKENS=4096
# Thinking depth / spend: low | medium | high | xhigh | max (Haiku 5.5's own default is medium).
ANTHROPIC_EFFORT=low
# There is no temperature setting: Haiku 5.5 rejects non-default sampling values.
ANTHROPIC_TIMEOUT_SECONDS=120
# Retries done by the app (the SDK's own retries are off), one recorded attempt each.
ANTHROPIC_MAX_RETRIES=2
# Where app LLM calls go. ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN are never read.
# ANTHROPIC_BASE_URL_OVERRIDE=https://api.anthropic.com
# Optional price overrides (USD per million tokens) used for the cost ledger, as JSON.
# Built-in table covers claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5.
# ANTHROPIC_PRICES={"claude-haiku-5-5": {"input_per_mtok": 0.10, "output_per_mtok": 0.50}}
# Model names the API may return, mapped to a priced model. Unmatched = unknown cost.
# ANTHROPIC_MODEL_ALIASES={"claude-haiku-5-5-20261001": "claude-haiku-5-5"}

# --- Email (Resend) for the approved seller request and sign-up verification links
RESEND_API_KEY=
# Verified sender address, e.g. "DealProof <requests@yourdomain.com>".
EMAIL_FROM=
# false = test mode for the seller request: sends are recorded as "suppressed (test mode)"
# and nothing leaves. Does not apply to sign-up emails, which go out whenever
# RESEND_API_KEY and EMAIL_FROM are set (without them the link is printed to the API log).
EMAIL_SEND_ENABLED=false

# --- Sign-in and sign-up (all optional; defaults shown)
# Session lifetime. The dp_session cookie is persistent (Max-Age), so it survives a
# browser restart until then. 168 = a week.
# AUTH_SESSION_TTL_HOURS=24
# Self-serve sign-up at /signup. false = 403 on POST /auth/signup; accounts come from
# `python -m app.auth.cli` only (also set NEXT_PUBLIC_SIGNUP_ENABLED=false for the web).
# AUTH_SIGNUP_ENABLED=true
# NEXT_PUBLIC_SIGNUP_ENABLED=true
# How long an email verification link works (single use).
# AUTH_VERIFICATION_TTL_HOURS=24
# Base URL of the web app used in emailed links. Unset: the first WEB_ORIGIN.
# AUTH_PUBLIC_WEB_URL=https://app.yourdomain.com
# Sign-up requests per (email, IP) / email / IP / overall, per window (seconds).
# AUTH_SIGNUP_MAX_PER_CLIENT=3
# AUTH_SIGNUP_MAX_PER_EMAIL=5
# AUTH_SIGNUP_MAX_PER_IP=10
# AUTH_SIGNUP_MAX_GLOBAL=200
# AUTH_SIGNUP_WINDOW_SECONDS=3600
# "Send a new link" requests per (email, IP) / email / IP, per window (seconds).
# AUTH_RESEND_MAX_PER_CLIENT=3
# AUTH_RESEND_MAX_PER_EMAIL=5
# AUTH_RESEND_MAX_PER_IP=20
# AUTH_RESEND_WINDOW_SECONDS=3600

# --- Storage
# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require).
DATABASE_URL=
# Private GCS bucket for uploaded case documents.
GCS_BUCKET=
# Uploaded documents are deleted after this many days.
UPLOAD_RETENTION_DAYS=30

# --- Cost control
# Max Crustdata credits a single case may spend; further checks become "Not checked (budget reached)".
CASE_CREDIT_BUDGET=150
# Max Crustdata credits for one thesis discover run, and for one investor search.
DISCOVER_CREDIT_BUDGET=60
INVESTOR_CREDIT_BUDGET=60

# --- Web / CORS
# Origin(s) of the web app allowed to call the API (comma-separated).
WEB_ORIGIN=http://localhost:3000
# Base URL of the API as seen by the browser (inlined into the web build).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. Shared by the web proxy and the API (server-only; set the same value on both).
# The web proxy signs the browser's IP with it so the API can rate-limit sign-ins per
# browser. Unset: the API limits every caller by the address it sees. `openssl rand -hex 32`.
PROXY_SHARED_SECRET=
